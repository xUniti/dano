{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DANO",
  "version": "0.1.0",
  "identifier": "com.dano.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DANO",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A local-first Life OS.",
    "longDescription": "DANO keeps your calendar, tasks, notes, projects, and habits in one place. It runs on your own computer, works offline, and keeps your data to yourself.",
    "copyright": "Copyright (c) 2026 xUniti",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
